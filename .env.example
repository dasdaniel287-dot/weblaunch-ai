# Server Configuration
PORT=3000
NODE_ENV=development
APP_URL="http://localhost:3000"
SESSION_SECRET="replace-with-strong-random-secret"

# Storage & Upload Limits
DATA_DIR=".weblaunch_data"
MAX_UPLOAD_BYTES=52428800
MAX_SINGLE_FILE_BYTES=15728640
MAX_FILES_PER_SITE=250
DEFAULT_USER_QUOTA_BYTES=104857600

# Optional Google OAuth (Client-side / Server verification)
GOOGLE_CLIENT_ID=""

# Cloudflare Workers / R2 / D1 Production Deployment
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_API_TOKEN=""
R2_BUCKET_NAME="weblaunch-sites"
D1_DATABASE_ID=""
SITE_BASE_DOMAIN="weblaunch.example.com"
